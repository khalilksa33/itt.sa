{
  "doctype": "DocType",
  "name": "Sub Agent",
  "module": "Contacts",
  "custom": 1,
  "autoname": "field:agency_name",
  "naming_rule": "By field",
  "fields": [
    {
      "fieldname": "agency_name",
      "fieldtype": "Data",
      "label": "Agency / Company Name",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "contact_person",
      "fieldtype": "Data",
      "label": "Primary Contact Person",
      "reqd": 1
    },
    {
      "fieldname": "email_id",
      "fieldtype": "Data",
      "label": "Business Email Address",
      "reqd": 1
    },
    {
      "fieldname": "mobile_no",
      "fieldtype": "Data",
      "label": "Phone / WhatsApp Number",
      "reqd": 1
    },
    {
      "fieldname": "custom_license_no",
      "fieldtype": "Data",
      "label": "Business License / Registration No"
    },
    {
      "fieldname": "city_country",
      "fieldtype": "Data",
      "label": "City & Country",
      "reqd": 1
    },
    {
      "fieldname": "experience_years",
      "fieldtype": "Int",
      "label": "Years of Experience",
      "default": "0"
    },
    {
      "fieldname": "agency_bio",
      "fieldtype": "Small Text",
      "label": "Brief Agency Profile"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Pending\nApproved\nSuspended",
      "default": "Pending",
      "reqd": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    },
    {
      "role": "Sales User",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    }
  ]
}
