# ----------------------------------------------------------------------
# Clean URLs: Rename .php to clean paths
# ----------------------------------------------------------------------
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# ----------------------------------------------------------------------
# Security Headers (Redundancy for Nginx settings)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # Modern standard for framing - allows itt.sa to frame itself
    Header set Content-Security-Policy "frame-ancestors 'self' https://itt.sa"
    
    # Legacy support for older browsers
    Header set X-Frame-Options "ALLOW-FROM https://itt.sa"
    
    # Prevents browsers from guessing MIME types
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# ----------------------------------------------------------------------
# Protect Configuration and PHP Bridge files
# ----------------------------------------------------------------------
<Files "bridge.php">
    # Optional: Restrict access to the bridge to your own domain only
    SetEnvIf Referer "^https://itt\.sa" local_referer
    Order Deny,Allow
    Deny from all
    Allow from env=local_referer
</Files>

# ----------------------------------------------------------------------
# Performance: Gzip Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>